# ══════════════════════════════════════════════════════════════════════════
# PRODUCTION CONFIG PROFILE — for the LIVE competition run.
#
# Every layer/rule in this project defaults OFF/conservative (see
# .env.example) so nothing changes behavior until explicitly turned on. That
# default is correct for development and PAPER testing, but it means a
# straight copy of .env.example into production would go LIVE with every
# Phase 4 layer disabled — trading on the bare Phase 3 pipeline only. This
# file is the deliberate, reviewed profile that turns on what the live run
# actually needs. Copy the values below into the real .env on the VPS; this
# file itself holds NO secrets (same convention as .env.example) — API keys
# and the wallet key still come from your own local .env, never committed.
#
# Do not flip AGENT_MODE to "live" until: the wallet is funded, registered
# on DoraHacks with the SAME address as WALLET_PRIVATE_KEY, and you have
# reviewed a PAPER run's decisions on this exact config. See README.md
# ("Switching to LIVE") for the full checklist.
# ══════════════════════════════════════════════════════════════════════════

DELPHI_NETWORK=competition-testnet
DELPHI_SIGNER_TYPE=private_key
# DELPHI_API_ACCESS_KEY=        <- your real testnet key, not committed
# WALLET_PRIVATE_KEY=           <- your real wallet key, not committed

# Flip to "live" only after the checklist above. Defaults to "paper" if unset
# — if you're unsure, leave this commented out and confirm PAPER first.
AGENT_MODE=live

# ── Phase 4 layers — ALL ON for the live run. Leaving any of these off in
# production silently reverts to the bare Phase 3 pipeline with no latency
# reaction, no long-tail prioritization, no coherence checks, and no
# opponent-fade corroboration — review each one's Phase 4 checkpoint report
# before enabling if you haven't already. ──────────────────────────────────
A_ENABLED=true
A_REFERENCE_MOVE_THRESHOLD=0.05
A_POLL_SECONDS=30

B_ENABLED=true

C_ENABLED=true

D_ENABLED=true
D_MIN_TRADES=5
D_MIN_NOTIONAL=5

# ── F1: thin-market fills — ON. The competition's LMSR markets can be very
# shallow (competition.md: some at minimum b); without this, a thin market
# with a real edge just gets skipped at gate f instead of taking a smaller,
# still-profitable position. ──────────────────────────────────────────────
THIN_MARKET_FILLS_ENABLED=true
HARD_MIN_SHARES=0.01
SLIPPAGE_TOLERANCE=0.02

# ── F2: token budget — keep the defaults unless you've provisioned a paid
# LLM tier. These are already calibrated against Groq's real limits
# (confirmed live via response headers — see llmClient.ts). ───────────────
LLM_DAILY_TOKEN_BUDGET=80000
FORECAST_STALENESS_MINUTES=30

# ── LLM provider — Groq free tier by default. If the competition's market
# volume grows past what the free tier can keep up with, switch providers
# here (see .env.example for the anthropic/openai-compatible options) rather
# than disabling forecasting. ──────────────────────────────────────────────
LLM_PROVIDER=groq
# GROQ_API_KEY=                 <- your real key, not committed

# ── Risk/sizing: production values are the same conservative defaults used
# throughout PAPER testing — do not loosen these for the live run without a
# specific reason logged in STRATEGY.md. ───────────────────────────────────
EDGE_THRESHOLD=0.05
KELLY_FRACTION=0.25
MAX_POSITION_TOKENS=10
MAX_TOTAL_EXPOSURE_TOKENS=100
MIN_CONFIDENCE=0.5
ORACLE_AMBIGUITY_SKIP_THRESHOLD=0.75

# ── Activity floor — the competition's minimum-activity thresholds. Tune
# these to the ACTUAL published rules before going live; the loop tracks
# these as a side effect and never forces a non-positive-EV trade to pad
# them (see risk/gates.ts, F1's doc comment). ──────────────────────────────
MIN_TRADES_OVER_WINDOW=10
MIN_DISTINCT_MARKETS=5

# ── Loop cadence — how often the persistent process runs a full pass,
# independent of Layer A's event-driven early wakeups. ─────────────────────
LOOP_CADENCE_SECONDS=300
