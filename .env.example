# ── Network (fixed for this project — competition-testnet only) ──────────────
DELPHI_NETWORK=competition-testnet

# ── API key (REQUIRED) — must be a TESTNET key ────────────────────────────────
# Generate at https://delphi-api-access.gensyn.ai/ — a mainnet key returns 401.
DELPHI_API_ACCESS_KEY=

# ── Signer (REQUIRED, even for read-only price fetches — see RULES.md) ───────
DELPHI_SIGNER_TYPE=private_key
WALLET_PRIVATE_KEY=

# ── Agent run mode: "paper" (default) or "live" ───────────────────────────────
# PAPER logs decisions + simulated fills and sends NO on-chain transactions.
# LIVE is enabled only once the wallet is funded and registered on DoraHacks.
AGENT_MODE=paper

# ── Optional: scope market reads to one competition (unset = active one) ─────
# DELPHI_COMPETITION_ID=

# ── Optional overrides (network defaults apply automatically otherwise) ──────
# GENSYN_RPC_URL=https://gensyn-testnet.g.alchemy.com/public
# GENSYN_CHAIN_ID=685685

# ── Optional risk/sizing tuning (sensible defaults if unset) ──────────────────
# EDGE_THRESHOLD=0.05
# DEFAULT_SLIPPAGE_BPS=200
# KELLY_FRACTION=0.25
# MAX_POSITION_TOKENS=10
# MAX_TOTAL_EXPOSURE_TOKENS=100
# MIN_TRADES_OVER_WINDOW=10
# MIN_DISTINCT_MARKETS=5
# MIN_CONFIDENCE=0.5
# ORACLE_AMBIGUITY_SKIP_THRESHOLD=0.75
# EXTREME_ZONE_MARGIN=0.05
# EXTREME_EDGE_MULTIPLIER=3
# EXTREME_SIZE_MULTIPLIER=0.25
# DUST_THRESHOLD_TOKENS=0.05
# PAPER_STARTING_BANKROLL=1000

# ── Optional signal sources (Phase 2) ──────────────────────────────────────────
# Polymarket + Binance consensus adapters need no key (public APIs).
# Sports odds consensus adapter — the-odds-api.com free tier (500 req/month).
# ODDS_API_KEY=
# LLM used for resolution structuring + forecasting (Anthropic Messages API).
# Without this, structuring degrades to the Phase 1 regex-based fields and
# forecasting returns no estimate (never a fabricated guess) — see RULES.md.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5
# Optional live news retrieval for forecasting (Tavily). Without this,
# forecasting reasons from the LLM's own knowledge only, and says so.
# SEARCH_API_KEY=
