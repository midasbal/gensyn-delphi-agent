# ── Network (fixed for this project — competition-testnet only) ──────────────
DELPHI_NETWORK=competition-testnet

# ── API key (REQUIRED) — must be a TESTNET key ────────────────────────────────
# Generate at https://delphi-api-access.gensyn.ai/ — a mainnet key returns 401.
DELPHI_API_ACCESS_KEY=

# ── Signer (REQUIRED, even for read-only price fetches — see RULES.md) ───────
DELPHI_SIGNER_TYPE=private_key
WALLET_PRIVATE_KEY=

# ── Agent run mode: "paper" (default) or "live" ───────────────────────────────
# PAPER logs decisions + simulated fills and sends NO on-chain transactions.
# LIVE is enabled only once the wallet is funded and registered on DoraHacks.
AGENT_MODE=paper

# ── Optional: scope market reads to one competition (unset = active one) ─────
# DELPHI_COMPETITION_ID=

# ── Optional overrides (network defaults apply automatically otherwise) ──────
# GENSYN_RPC_URL=https://gensyn-testnet.g.alchemy.com/public
# GENSYN_CHAIN_ID=685685

# ── Optional risk/sizing tuning (sensible defaults if unset) ──────────────────
# EDGE_THRESHOLD=0.05
# DEFAULT_SLIPPAGE_BPS=200
# KELLY_FRACTION=0.25
# MAX_POSITION_TOKENS=10
# Fraction of live account value (bankroll plus current cost basis) that may be
# committed across all open positions at once. Replaces the old flat
# MAX_TOTAL_EXPOSURE_TOKENS, which never scaled with the account.
# MAX_TOTAL_EXPOSURE_FRACTION=0.65
# Fraction of live account value that may be committed to a single market's entry.
# MAX_PER_MARKET_EXPOSURE_FRACTION=0.10
# MIN_TRADES_OVER_WINDOW=10
# MIN_DISTINCT_MARKETS=5
# MIN_CONFIDENCE=0.5
# Trade-scored calibration found large divergences from the market price were
# anti-signal, not opportunity. Shrinks ourProbability toward the quoted price
# before edge/sizing: 0 = trust the model fully (old behavior), 1 = trust the
# market fully (never trades). 0.5 moves our estimate halfway to the market.
# MARKET_SHRINK_LAMBDA=0.5
# Hard cutoff on the RAW |ourProbability - price| divergence, before shrinking.
# Every trade past this threshold in the calibration data lost money.
# MAX_RAW_EDGE=0.25
# ORACLE_AMBIGUITY_SKIP_THRESHOLD=0.75
# EXTREME_ZONE_MARGIN=0.05
# EXTREME_EDGE_MULTIPLIER=3
# EXTREME_SIZE_MULTIPLIER=0.25
# DUST_THRESHOLD_TOKENS=0.05
# PAPER_STARTING_BANKROLL=1000
# Caps a forecast-ONLY signal's influence on sizing (no consensus backing) —
# protects against an uncalibrated model dominating a trade. See RULES.md.
# FORECAST_ONLY_MAX_WEIGHT=0.5

# ── Optional signal sources (Phase 2) ──────────────────────────────────────────
# Polymarket + Binance consensus adapters need no key (public APIs).
# Sports odds consensus adapter — the-odds-api.com free tier (500 req/month).
# ODDS_API_KEY=

# LLM used for resolution structuring + forecasting. Without a key for the
# selected provider, structuring degrades to the Phase 1 regex-based fields
# and forecasting returns no estimate (never a fabricated guess) — see RULES.md.
# LLM_PROVIDER = "groq" (default, free tier) | "anthropic" | "openai-compatible"
# LLM_PROVIDER=groq

# Groq (default provider) — OpenAI-compatible API at api.groq.com/openai/v1.
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=
# Default model if LLM_MODEL is unset: llama-3.3-70b-versatile — confirmed
# live against console.groq.com/docs/models (production, 131k context, no
# deprecation warning as of 2026-08-06). Free tier for this model, confirmed
# LIVE from x-ratelimit-* response headers: 1,000 requests/day (not a
# practical concern — see F2 below) and 12,000 tokens/MINUTE, which IS the
# binding limit and is what tokenBudget.ts's throttleForRateLimit() paces
# calls under. The client also backs off on 429s as a fallback. Override
# here if Groq changes their lineup:
# LLM_MODEL=llama-3.3-70b-versatile

# Anthropic (LLM_PROVIDER=anthropic) — Messages API.
# ANTHROPIC_API_KEY=
# (LLM_MODEL default for this provider: claude-sonnet-5)

# Any OpenAI-chat-completions-shaped endpoint (LLM_PROVIDER=openai-compatible)
# — local vLLM/Ollama, another hosted provider, etc.
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Optional live news retrieval for forecasting (Tavily). Without this,
# forecasting reasons from the LLM's own knowledge only, and says so.
# SEARCH_API_KEY=

# ── Phase 4 layers — each defaults to false/disabled; opt in explicitly ──────
# Layer A — latency: consensus-driven requeue, no LLM call.
# A_ENABLED=false
# A_REFERENCE_MOVE_THRESHOLD=0.05
# A_POLL_SECONDS=30
# Layer B — long-tail routing (feeds F2's forecast priority).
# B_ENABLED=false
# Layer C — cross-market coherence (within-market drift + across-market pairs).
# C_ENABLED=false
# Layer D — opponent modeling (PUBLIC subgraph data only; fades only when our
# own signal already supports the other side — see RULES.md). A herding call
# requires BOTH a minimum trade count AND a minimum total notional in the
# observed window, so a few dust-sized trades never count as a crowd.
# D_ENABLED=false
# D_MIN_TRADES=5
# D_MIN_NOTIONAL=5

# ── F1: thin-market fill rule (replaces gate f's hard skip when enabled) ─────
# THIN_MARKET_FILLS_ENABLED=false
# Absolute technical floor (share granularity) — never filled below this.
# HARD_MIN_SHARES=0.01
# Slippage tolerance as a fraction. Defaults from DEFAULT_SLIPPAGE_BPS if unset.
# SLIPPAGE_TOLERANCE=0.02

# ── F2: forecast token-budget governor ────────────────────────────────────────
# Two independent layers (tokenBudget.ts): a rolling 24h budget below (this
# project's own accounting; Groq's real daily figure is 1,000 REQUESTS, not a
# practical concern) and a per-minute rate limiter hardcoded to Groq's real
# 12,000-tokens/MINUTE cap with margin (confirmed live from x-ratelimit-*
# headers 2026-08-06) — that one actually paces/sleeps between calls, see
# forecast.ts's throttleForRateLimit(). llmClient.ts's 429 backoff is the
# fallback behind both.
# LLM_DAILY_TOKEN_BUDGET=80000
# Re-forecast a market after this many minutes even with unchanged inputs.
# FORECAST_STALENESS_MINUTES=30

# ── Conditional search — spend Tavily/search tokens only where they could
# actually change a decision ──────────────────────────────────────────────
# When SEARCH_API_KEY is set, forecast.ts runs a cheap no-search forecast
# FIRST, then only pays for a second, search-augmented re-forecast if BOTH:
# (a) the cheap forecast's confidence is below FORECAST_SEARCH_CONF_THRESHOLD,
# AND (b) it already implies a tradeable edge vs the market price (>=
# FORECAST_SEARCH_MIN_EDGE). If the cheap forecast is already confident, or
# already agrees with the price, sharpening it with search would change no
# trade decision — skip it and keep the cheap result. A failed/empty search
# after being triggered also keeps the cheap result (never a wasted second
# LLM call on a re-forecast with no new evidence, never a hard failure just
# because the optional search leg didn't pan out).
# CONDITIONAL_SEARCH_ENABLED=true
# FORECAST_SEARCH_CONF_THRESHOLD=0.5
# Defaults to EDGE_THRESHOLD (risk/gates.ts's own trade-worthiness bar) if unset.
# FORECAST_SEARCH_MIN_EDGE=0.05
